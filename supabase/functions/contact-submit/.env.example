# Edge Function Environment Variables Reference
# Copy relevant variables to: Supabase Dashboard → Project Settings → Edge Functions → Secrets

# ─── Email Provider ───────────────────────────────────────────────────────────
# Recommended: Resend (https://resend.com) — free tier: 3000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback SMTP (if not using Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sender identity (shown in email "From" field)
SMTP_FROM=HMPTI UNESA <noreply@hmptiunesa.ac.id>

# ─── Contact Form Destination ─────────────────────────────────────────────────
# The organization's inbox that receives contact form submissions
CONTACT_TO=hmpti@unesa.ac.id

# ─── CORS Origin ─────────────────────────────────────────────────────────────
# Your frontend domain (prevents unauthorized origins from calling this function)
ALLOWED_ORIGIN=https://hmptiunesa.ac.id
