# =============================================================================
# HMPTI UNESA Website — Environment Variables Reference
# =============================================================================
#
# Frontend (.env in /frontend):
#   VITE_SUPABASE_URL       — Your Supabase project URL
#   VITE_SUPABASE_ANON_KEY  — Your Supabase publishable anon key (safe for browser)
#
# Edge Functions (set in Supabase Dashboard → Edge Functions → Secrets):
#   RESEND_API_KEY    — Resend transactional email API key
#   SMTP_FROM         — Sender "From" address, e.g. "HMPTI UNESA <noreply@hmptiunesa.ac.id>"
#   CONTACT_TO        — Organization inbox receiving contact form submissions
#   ALLOWED_ORIGIN    — Frontend origin for CORS (e.g. https://hmptiunesa.ac.id)
#
# NEVER commit:
#   - Supabase service_role key
#   - SMTP credentials
#   - Resend API key
#   - Any other server-side secret
# =============================================================================

# ─── Frontend (VITE_ prefix — safe for browser bundle) ────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Edge Function Secrets (SERVER SIDE ONLY — never in Vite build) ───────────
# Set these in: Supabase Dashboard → Project → Settings → Edge Functions → Secrets
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=HMPTI UNESA <noreply@hmptiunesa.ac.id>
CONTACT_TO=hmpti@unesa.ac.id
ALLOWED_ORIGIN=https://hmptiunesa.ac.id
